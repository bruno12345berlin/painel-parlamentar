---
import Base from "../../layouts/Base.astro";
import { fatias, type Fatia } from "../../lib/slice";
import { formatarData, formatarPercentual, formatarReais } from "../../lib/format";
import { ROTULOS, type Categoria } from "../../../pipeline/metrics/categorias";

export function getStaticPaths() {
  return fatias.map((f) => ({ params: { slug: f.parlamentar.slug }, props: { f } }));
}
const { f } = Astro.props as { f: Fatia };
const p = f.parlamentar;
const meses = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];
const cats = Object.entries(f.gastos.porCategoria).sort((a, b) => b[1] - a[1]);
const maxMes = Math.max(...f.gastos.porMes.map(Math.abs), 1);
const maxCat = Math.max(...cats.map(([, v]) => Math.abs(v)), 1);
const TIPOS = ["PL", "PLP", "PEC", "PDL", "PRC", "PDS", "PRS"];
const sigla = (x: Fatia["projetos"]["lista"][number]) => x.identificacao ?? `${x.sigla} ${x.numero}/${x.ano}`;
const outros = f.projetos.total - f.projetos.projetosPrincipal - f.projetos.projetosCoautor;
---

<Base titulo={`${p.nome} (protótipo)`}>
  <p class="mb-4 rounded border p-3 text-sm" style="background:var(--alert-bg);border-color:var(--alert-border);color:var(--alert-text)">
    <strong>Protótipo descartável (Fase 2).</strong> Serve só para validar o modelo de dados e o tamanho da página. O layout definitivo será escolhido na Fase 3.
    Dados de {f.ano}, gerados em {formatarData(f.geradoEm)}.
  </p>

  <h1 class="text-3xl font-bold">{p.nome}</h1>
  <p style="color:var(--muted)">
    {p.casa === "camara" ? "Deputado federal" : "Senador"} · {p.partidoNoAno.join(", ")}-{p.uf} ·
    <a href={p.fonteUrl}>página oficial</a>
  </p>

  <section class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Resumo">
    <div class="rounded border p-4" style="border-color:var(--border)">
      <h2 class="text-sm font-semibold">Gasto da cota em {f.ano}</h2>
      <p class="text-2xl font-bold">{formatarReais(f.gastos.total)}</p>
      <p class="text-sm" style="color:var(--muted)">{f.gastos.linhas} lançamentos. Percentual da cota: indisponível (limites por UF pendentes).</p>
    </div>
    <div class="rounded border p-4" style="border-color:var(--border)">
      <h2 class="text-sm font-semibold">Participação em votações</h2>
      <p class="text-2xl font-bold">{f.participacao.fracao === null ? "—" : formatarPercentual(f.participacao.fracao)}</p>
      <p class="text-sm" style="color:var(--muted)">Votou em {f.participacao.votou} de {f.participacao.total} votações nominais do Plenário.</p>
    </div>
    <div class="rounded border p-4" style="border-color:var(--border)">
      <h2 class="text-sm font-semibold">Alinhamento com o partido</h2>
      {
        f.alinhamento && f.alinhamento.fracao !== null ? (
          <>
            <p class="text-2xl font-bold">{formatarPercentual(f.alinhamento.fracao)}</p>
            <p class="text-sm" style="color:var(--muted)">{f.alinhamento.alinhados} de {f.alinhamento.total} votações com orientação.</p>
          </>
        ) : (
          <>
            <p class="text-2xl font-bold">Não disponível</p>
            <p class="text-sm" style="color:var(--muted)">O Senado não publica orientação de bancada. <a href="/metodologia">Entenda</a>.</p>
          </>
        )
      }
    </div>
    <div class="rounded border p-4" style="border-color:var(--border)">
      <h2 class="text-sm font-semibold">Projetos apresentados</h2>
      <p class="text-2xl font-bold">{f.projetos.projetosPrincipal + f.projetos.projetosCoautor}</p>
      <p class="text-sm" style="color:var(--muted)">
        {f.projetos.projetosPrincipal} como autor principal e {f.projetos.projetosCoautor} como coautor (PL, PLP, PEC, PDL e similares). Outros tipos de proposição: {outros}.
      </p>
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Gastos por categoria</h2>
    <table class="mt-3 w-full text-sm">
      <caption class="sr-only">Gasto da cota por categoria em {f.ano}</caption>
      <thead><tr class="text-left"><th scope="col" class="py-1">Categoria</th><th scope="col" class="py-1 text-right">Valor</th><th scope="col" class="w-1/3 py-1"><span class="sr-only">Proporção</span></th></tr></thead>
      <tbody>
        {
          cats.map(([k, v]) => (
            <tr class="border-t" style="border-color:var(--border)">
              <th scope="row" class="py-1 text-left font-normal">{ROTULOS[k as Categoria] ?? k}</th>
              <td class="py-1 text-right">{formatarReais(v)}</td>
              <td class="py-1 pl-3"><div style={`height:10px;width:${Math.max(0, (v / maxCat) * 100)}%;background:var(--cat-1)`}></div></td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 class="mt-6 font-semibold">Por mês</h3>
    <table class="mt-2 w-full text-sm">
      <caption class="sr-only">Gasto da cota por mês em {f.ano}</caption>
      <thead><tr class="text-left"><th scope="col">Mês</th><th scope="col" class="text-right">Valor</th><th scope="col" class="w-1/3"><span class="sr-only">Proporção</span></th></tr></thead>
      <tbody>
        {
          f.gastos.porMes.map((v, i) => (
            <tr class="border-t" style="border-color:var(--border)">
              <th scope="row" class="py-1 text-left font-normal">{meses[i]}</th>
              <td class="py-1 text-right">{formatarReais(v)}</td>
              <td class="py-1 pl-3"><div style={`height:10px;width:${Math.max(0, (v / maxMes) * 100)}%;background:var(--cat-2)`}></div></td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h3 class="mt-6 font-semibold">Maiores fornecedores</h3>
    <ul class="mt-2 text-sm">
      {f.gastos.maioresFornecedores.map((x) => <li class="border-t py-1" style="border-color:var(--border)">{x.fornecedor} <span style="color:var(--muted)">({x.documento})</span>: {formatarReais(x.total)}</li>)}
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Votações mais recentes do Plenário</h2>
    <ul class="mt-3 space-y-3 text-sm">
      {
        f.votacoesRecentes.slice(0, 10).map((v) => (
          <li class="border-t pt-2" style="border-color:var(--border)">
            <p>{formatarData(v.data)}: {v.descricao}</p>
            <p><strong>Voto: {v.voto}</strong>{v.orientacaoBancada ? ` · orientação da bancada (${v.partidoNoVoto}): ${v.orientacaoBancada}` : ""}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-semibold">Projetos apresentados em {f.ano}</h2>
    <ul class="mt-3 space-y-2 text-sm">
      {
        f.projetos.lista.filter((x) => TIPOS.includes(x.sigla)).map((x) => (
          <li class="border-t pt-2" style="border-color:var(--border)">
            <a href={x.url}>{sigla(x)}</a> ({x.principal ? "autor principal" : "coautor"}): {x.ementa}
          </li>
        ))
      }
    </ul>
  </section>
</Base>
