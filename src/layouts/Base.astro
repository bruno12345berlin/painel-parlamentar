---
import "../styles/global.css";
import { site } from "../../site.config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AvisoDesatualizado from "../components/AvisoDesatualizado.astro";

interface Props {
  titulo?: string;
  descricao?: string;
}
const { titulo, descricao = site.tagline } = Astro.props;
const tituloCompleto = titulo ? `${titulo} | ${site.name}` : site.name;
const canonica = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
  </head>
  <body class="min-h-screen">
    <a href="#conteudo" class="skip-link">Ir para o conteúdo</a>
    <AvisoDesatualizado />
    <Header />
    <main id="conteudo" class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
